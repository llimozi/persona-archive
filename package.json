{
  "name": "persona-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --clear-screen=false src/api/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "pnpm typecheck && pnpm build:web && pnpm build:api",
    "build:web": "vite build --config vite.config.ts",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "node dist/api/src/api/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "validate": "tsx data/validate-data.mjs",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "canvas-confetti": "^1.9.4",
    "fastify": "^5.2.1",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
